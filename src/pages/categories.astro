---
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'
import { getCollection } from 'astro:content'

import CTA from '../components/cta.astro'
import PageHero from '../components/pagehero.astro'
import { DefaultImage } from '../config'
import Base from '../layouts/base.astro'

const frontmatter: CollectionEntry<'page'>['data'] = {
  draft: false,
  title: 'Categories',
  description: 'Categories for articles',
  image: DefaultImage
}

const categories = await getCollection('category')
---

<Base frontmatter={frontmatter}>
  <header>
    <PageHero frontmatter={frontmatter} />
  </header>
  <main class="mt-8 bg-gray-100 dark:bg-gray-900">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl pb-72 sm:pb-32 lg:max-w-none lg:pb-24">
        <div class="mt-6 space-y-12 lg:grid lg:grid-cols-3 lg:space-y-0 lg:gap-x-6">
          {
            categories.map((category) => (
              <div class="group relative">
                <div class="sm:aspect-h-1 sm:aspect-w-2 lg:aspect-h-1 lg:aspect-w-1 relative mb-4 h-80 w-full overflow-hidden rounded-lg bg-orange-100 group-hover:opacity-75 sm:h-64 dark:bg-orange-600">
                  <Image
                    src={category.data.image}
                    alt={category.data.description}
                    class="h-full w-full object-cover object-center"
                    loading="lazy"
                  />
                </div>
                <h3 class="inline-block rounded bg-orange-600 px-3 py-1 text-xs font-medium tracking-tight text-white uppercase hover:bg-pink-600">
                  <a href={`${import.meta.env.BASE_URL}category/${category.id}/`}>
                    <span class="absolute inset-0" />
                    {category.data.title}
                  </a>
                </h3>
                <p class="text-base text-gray-900 dark:text-gray-400">
                  {category.data.description}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
    <CTA />
  </main>
</Base>
