---
import { Image } from 'astro:assets'
import { getCollection } from 'astro:content'

import CTA from '../components/cta.astro'
import PageHero from '../components/pagehero.astro'
import { DefaultImage, LogoImage } from '../config'
import Base from '../layouts/base.astro'

import type { CollectionEntry } from 'astro:content'

const frontmatter: CollectionEntry<'page'>['data'] = {
  draft: false,
  title: 'Contact',
  description: 'Please reach out to us via the form below.',
  image: LogoImage
}

const social = await getCollection('social')
---

<Base frontmatter={frontmatter}>
  <header>
    <PageHero frontmatter={frontmatter} />
  </header>
  <main>
    <section class="mx-auto mb-20 max-w-7xl text-gray-800 dark:text-gray-100">
      <div class="block bg-white lg:my-8 dark:bg-gray-900">
        <div class="flex flex-wrap items-start">
          <div class="block w-full shrink-0 grow-0 basis-auto lg:flex lg:w-6/12 xl:w-4/12">
            <div class="w-full">
              <Image src={DefaultImage} alt="cover image" />
            </div>
          </div>
          <div class="w-full shrink-0 grow-0 basis-auto lg:w-6/12 xl:w-8/12">
            <div class="flex flex-wrap pt-8 lg:pt-0">
              {
                social.map((method) => (
                  <div class="mb-12 w-full shrink-0 grow-0 basis-auto px-3 md:w-6/12 md:px-6 lg:w-full xl:w-6/12 xl:px-12">
                    <div class="flex items-start">
                      <div class="shrink-0">
                        <div
                          class={`i-bi-${method.data.icon} flex h-14 w-14 items-center justify-center rounded-md bg-orange-600 p-4 text-white shadow-md`}
                        />
                      </div>
                      <div class="ml-6 grow">
                        <p class="mb-1 font-bold">{method.data.name}</p>
                        <p>
                          {' '}
                          <a
                            href={method.data.link}
                            class="text-orange-600 hover:text-pink-600 dark:text-orange-300 dark:hover:text-pink-300"
                          >
                            {method.data.link}
                          </a>
                        </p>
                      </div>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
        <form
          name="contact"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          class="mt-8 space-y-8"
        >
          <div>
            <p class="hidden">
              <label>
                Don’t fill this out if you’re human: <input name="bot-field" />
              </label>
            </p>
            <label
              for="email"
              class="mb-2 block text-sm font-medium text-gray-900 dark:text-gray-300"
              >Your email</label
            >
            <input
              type="email"
              id="email"
              name="email"
              class="dark:shadow-sm-light block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 shadow-sm focus:border-orange-500 focus:ring-orange-500 dark:border-gray-600 dark:bg-gray-700 dark:text-white dark:placeholder-gray-400 dark:focus:border-orange-500 dark:focus:ring-orange-500"
              placeholder="name@email.com"
              required
            />
          </div>
          <div>
            <label
              for="subject"
              class="mb-2 block text-sm font-medium text-gray-900 dark:text-gray-300">Subject</label
            >
            <input
              type="text"
              id="subject"
              name="subject"
              class="dark:shadow-sm-light block w-full rounded-lg border border-gray-300 bg-gray-50 p-3 text-sm text-gray-900 shadow-sm focus:border-orange-500 focus:ring-orange-500 dark:border-gray-600 dark:bg-gray-700 dark:text-white dark:placeholder-gray-400 dark:focus:border-orange-500 dark:focus:ring-orange-500"
              placeholder="Let us know how we can help you"
              required
            />
          </div>
          <div class="sm:col-span-2">
            <label
              for="message"
              class="mb-2 block text-sm font-medium text-gray-900 dark:text-gray-400"
              >Your message</label
            >
            <textarea
              id="message"
              name="message"
              rows="6"
              class="block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 shadow-sm focus:border-orange-500 focus:ring-orange-500 dark:border-gray-600 dark:bg-gray-700 dark:text-white dark:placeholder-gray-400 dark:focus:border-orange-500 dark:focus:ring-orange-500"
              placeholder="Leave a comment…"></textarea>
          </div>
          <button
            type="submit"
            id="submit-button"
            class="rounded-lg bg-orange-700 px-5 py-3 text-center text-sm font-medium text-white hover:bg-orange-800 focus:ring-4 focus:ring-orange-300 focus:outline-none sm:w-fit dark:bg-orange-600 dark:hover:bg-orange-700 dark:focus:ring-orange-800"
            >Send message</button
          >
        </form>
      </div>
    </section>
    <CTA />
  </main>
</Base>

<script>
  const form = document.querySelector('form[name="contact"]') as HTMLFormElement
  const submitBtn = document.querySelector('#submit-button') as HTMLButtonElement

  if (form && submitBtn) {
    form.addEventListener('submit', () => {
      submitBtn.disabled = true
      submitBtn.innerHTML = `
        <div class="flex items-center">
          <svg class="mr-3 h-4 w-4 animate-spin text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          Sending…
        </div>
      `
    })
  }
</script>
