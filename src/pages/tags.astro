---
import { type CollectionEntry, getCollection } from 'astro:content'
import {
  autumn as _autumn,
  aztec as _aztec,
  bamboo as _bamboo,
  bankNote as _bankNote,
  bathroomFloor as _bathroomFloor,
  boxes as _boxes,
  cage as _cage,
  charlieBrown as _charlieBrown,
  churchOnSunday as _churchOnSunday,
  connections as _connections,
  corkScrew as _corkScrew,
  cutout as _cutout,
  deathStar as _deathStar,
  diagonalLines as _diagonalLines,
  endlessClouds as _endlessClouds,
  eyes as _eyes,
  fancyRectangles as _fancyRectangles,
  flippedDiamonds as _flippedDiamonds,
  graphPaper as _graphPaper,
  groovy as _groovy,
  happyIntersection as _happyIntersection,
  heavyRain as _heavyRain,
  houndstooth as _houndstooth,
  jupiter as _jupiter,
  kiwi as _kiwi,
  lips as _lips,
  lisbon as _lisbon,
  melt as _melt,
  morphingDiamonds as _morphingDiamonds,
  overlappingHexagons as _overlappingHexagons,
  parkayFloor as _parkayFloor,
  pianoMan as _pianoMan,
  pieFactory as _pieFactory,
  pixelDots as _pixelDots,
  signal as _signal,
  steelBeams as _steelBeams,
  temple as _temple,
  tinyCheckers as _tinyCheckers,
  wallpaper as _wallpaper,
  zigZag as _zigZag
} from 'hero-patterns'

const autumn = _autumn
const aztec = _aztec
const bamboo = _bamboo
const bankNote = _bankNote
const bathroomFloor = _bathroomFloor
const boxes = _boxes
const cage = _cage
const charlieBrown = _charlieBrown
const churchOnSunday = _churchOnSunday
const connections = _connections
const corkScrew = _corkScrew
const cutout = _cutout
const deathStar = _deathStar
const diagonalLines = _diagonalLines
const endlessClouds = _endlessClouds
const eyes = _eyes
const fancyRectangles = _fancyRectangles
const flippedDiamonds = _flippedDiamonds
const graphPaper = _graphPaper
const groovy = _groovy
const happyIntersection = _happyIntersection
const heavyRain = _heavyRain
const houndstooth = _houndstooth
const jupiter = _jupiter
const kiwi = _kiwi
const lips = _lips
const lisbon = _lisbon
const melt = _melt
const morphingDiamonds = _morphingDiamonds
const overlappingHexagons = _overlappingHexagons
const parkayFloor = _parkayFloor
const pianoMan = _pianoMan
const pieFactory = _pieFactory
const pixelDots = _pixelDots
const signal = _signal
const steelBeams = _steelBeams
const temple = _temple
const tinyCheckers = _tinyCheckers
const wallpaper = _wallpaper
const zigZag = _zigZag

import CTA from '../components/cta.astro'
import PageHero from '../components/pagehero.astro'
import { DefaultImage } from '../config'
import Base from '../layouts/base.astro'

import type { TagType } from '../config'

const patterns = [
  steelBeams('#9c92ac', 0.5),
  jupiter('#9c92ac', 0.5),
  cutout('#9c92ac', 0.5),
  pianoMan('#9c92ac', 0.5),
  pieFactory('#9c92ac', 0.5),
  graphPaper('#9c92ac', 0.5),
  charlieBrown('#9c92ac', 0.5),
  autumn('#9c92ac', 0.5),
  temple('#9c92ac', 0.5),
  deathStar('#9c92ac', 0.5),
  churchOnSunday('#9c92ac', 0.5),
  overlappingHexagons('#9c92ac', 0.5),
  bamboo('#9c92ac', 0.5),
  bathroomFloor('#9c92ac', 0.5),
  corkScrew('#9c92ac', 0.5),
  happyIntersection('#9c92ac', 0.5),
  kiwi('#9c92ac', 0.5),
  lips('#9c92ac', 0.5),
  lisbon('#9c92ac', 0.5),
  tinyCheckers('#9c92ac', 0.5),
  fancyRectangles('#9c92ac', 0.5),
  heavyRain('#9c92ac', 0.5),
  cage('#9c92ac', 0.5),
  connections('#9c92ac', 0.5),
  flippedDiamonds('#9c92ac', 0.5),
  houndstooth('#9c92ac', 0.5),
  morphingDiamonds('#9c92ac', 0.5),
  zigZag('#9c92ac', 0.5),
  aztec('#9c92ac', 0.5),
  bankNote('#9c92ac', 0.5),
  boxes('#9c92ac', 0.5),
  diagonalLines('#9c92ac', 0.5),
  endlessClouds('#9c92ac', 0.5),
  eyes('#9c92ac', 0.5),
  groovy('#9c92ac', 0.5),
  melt('#9c92ac', 0.5),
  parkayFloor('#9c92ac', 0.5),
  pixelDots('#9c92ac', 0.5),
  signal('#9c92ac', 0.5),
  wallpaper('#9c92ac', 0.5)
]

const frontmatter: CollectionEntry<'page'>['data'] = {
  draft: false,
  title: 'Tags',
  description: 'Articles by tags',
  image: DefaultImage
}

const posts = await getCollection('blog', ({ data }) => {
  return data.draft !== true
})
const latestPosts = posts.toSorted((a, b) =>
  a.data.pubDate && b.data.pubDate ? +b.data.pubDate - +a.data.pubDate : 0
)

const tagmap = new Map<string, TagType>()

latestPosts.forEach((post) => {
  post.data.tags?.forEach((tag) => {
    let utag = tagmap.get(tag)
    if (utag) {
      utag.count += 1
      utag.pages.push(post)
    } else {
      utag = { tag: tag, count: 1, pages: [post] }
    }
    tagmap.set(tag, utag)
  })
})

const tags = [...tagmap.values()]
---

<Base frontmatter={frontmatter}>
  <header>
    <PageHero frontmatter={frontmatter} />
  </header>
  <main class="mt-10 dark:bg-gray-900">
    <div
      class="mx-4 mt-6 mb-24 grid grid-cols-2 gap-x-4 gap-y-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 xl:gap-x-6 xl:gap-y-6"
    >
      {
        tags
          .toSorted((a, b) => b.count - a.count)
          .map((tag, i) => (
            <a href={`${import.meta.env.BASE_URL}tag/${tag.tag}/`} class="group">
              <section
                class="group relative h-24 w-full overflow-hidden rounded-lg bg-cover bg-center shadow-lg transition duration-300 ease-in-out hover:shadow-2xl"
                style={{
                  backgroundColor: '#dfdbe5',
                  // backgroundImage: `url(${OGImage})`,
                  backgroundImage: patterns[i % patterns.length]
                }}
              >
                <div class="bg-opacity-50 absolute inset-0 bg-black transition duration-300 ease-in-out group-hover:opacity-75" />
                <div class="relative flex h-full w-full items-center justify-center px-4 sm:px-6 lg:px-4">
                  <h3 class="text-center text-2xl font-bold text-white">
                    <span class="absolute inset-0" />
                    {tag.tag}
                  </h3>
                  <p class="text-center text-sm font-medium text-gray-200">&nbsp;({tag.count})</p>
                </div>
              </section>
            </a>
          ))
      }
    </div>
    <CTA />
  </main>
</Base>
