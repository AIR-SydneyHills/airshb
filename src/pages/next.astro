---
import { getCollection, render } from 'astro:content'

import image from '../assets/site/retirementahead.jpg'
import { SiteMetadata } from '../config'
import Base from '../layouts/base.astro'

import type { CollectionEntry } from 'astro:content'

const frontmatter: CollectionEntry<'page'>['data'] = {
  draft: false,
  title: 'Next Meeting',
  description: SiteMetadata.description,
  image: image
}

const [next] = await getCollection('next')
const { Content } = await render(next)
---

<script is:inline slot="in-head" src="https://identity.netlify.com/v1/netlify-identity-widget.js"
></script>
<Base frontmatter={frontmatter}>
  <main class="mx-auto max-w-screen-lg bg-white dark:bg-gray-900">
    <h2 class="mb-4 text-3xl font-bold tracking-tight text-gray-900 dark:text-white">
      Next Meeting: {next.data.title}
    </h2>
    <section class="prose prose-gray lg:prose-xl dark:prose-invert">
      <Content />
    </section>
  </main>
</Base>
