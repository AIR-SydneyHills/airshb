---
import { getImage } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'
import { getCollection } from 'astro:content'
import type { TwitterCardType } from 'astro-seo'
import { SEO } from 'astro-seo'
import type {
  Article,
  BreadcrumbList,
  Event,
  Organization,
  Person,
  WebSite,
  WithContext
} from 'schema-dts'

import { DefaultImage, LogoImage, SiteMetadata } from '../config'

export interface Props {
  frontmatter:
    | CollectionEntry<'page'>['data']
    | CollectionEntry<'blog'>['data']
    | CollectionEntry<'meeting'>['data']
}

const { frontmatter } = Astro.props

const social = await getCollection('social')
const siteurl = new URL(import.meta.env.BASE_URL, Astro.url)
const canonicalURL = new URL(Astro.url.pathname, Astro.site)

// Determine content type for schema and meta
const isBlog = Astro.url.toString().includes('/blog/')
const isNews = Astro.url.toString().includes('/news/')
const isMeeting = Astro.url.toString().includes('/meeting/')
const type = isBlog || isNews ? 'post' : 'page'

const year = SiteMetadata.buildTime.getFullYear()
const image = await getImage({
  src: frontmatter.image ?? DefaultImage,
  width: 1200,
  format: 'jpg'
})
const logo = LogoImage
const publishDate = frontmatter.pubDate ?? SiteMetadata.buildTime

const openGraph = {
  basic: {
    title: frontmatter.title ?? SiteMetadata.title,
    type: isBlog || isNews ? 'article' : 'website',
    image: new URL(image.src, Astro.url).toString()
  },
  optional: {
    description: frontmatter.description ?? SiteMetadata.description,
    siteName: SiteMetadata.title,
    locale: 'en_AU'
  },
  image: {
    alt: frontmatter.title ?? SiteMetadata.title,
    height: image.attributes.height,
    width: image.attributes.width
  },
  article:
    isBlog || isNews
      ? {
          author: SiteMetadata.author.name,
          publishedTime: publishDate.toISOString(),
          tags: (frontmatter as CollectionEntry<'blog'>['data']).tags
        }
      : undefined
}

const twitter = {
  card: (frontmatter.image ? 'summary_large_image' : 'summary') as TwitterCardType,
  site: SiteMetadata.org.twitter,
  creator: SiteMetadata.author.twitter
}

const website: WithContext<WebSite> = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  about: {
    '@id': new URL('about', siteurl).toString()
  },
  audience: 'public',
  abstract: SiteMetadata.description,
  author: {
    '@id': SiteMetadata.author.url
  },
  copyrightHolder: {
    '@id': SiteMetadata.org.url
  },
  copyrightYear: year,
  creator: {
    '@id': SiteMetadata.author.url
  },
  description: SiteMetadata.description,
  image: {
    '@type': 'ImageObject',
    url: new URL(image.src, Astro.url).toString()
  },
  inLanguage: 'en-AU',
  name: SiteMetadata.title,
  publisher: {
    '@id': SiteMetadata.org.url
  },
  url: siteurl.toString()
}

const organization: WithContext<Organization> = {
  '@context': 'https://schema.org',
  '@id': SiteMetadata.org.url,
  '@type': 'Organization',
  address: {
    '@type': 'PostalAddress',
    streetAddress: SiteMetadata.location
  },
  contactPoint: {
    '@type': 'ContactPoint',
    email: SiteMetadata.org.email,
    contactType: 'customer support'
  },
  description: SiteMetadata.org.summary,
  email: SiteMetadata.org.email,
  founder: {
    '@id': SiteMetadata.author.email
  },
  location: {
    '@type': 'Place',
    address: {
      '@type': 'PostalAddress',
      streetAddress: SiteMetadata.location
    },
    name: 'Meeting Location',
    geo: {
      '@type': 'GeoCoordinates',
      latitude: SiteMetadata.latlng[0],
      longitude: SiteMetadata.latlng[1]
    }
  },
  image: {
    '@type': 'ImageObject',
    url: new URL(logo.src, siteurl).toString()
  },
  logo: {
    '@type': 'ImageObject',
    url: new URL(logo.src, siteurl).toString()
  },
  name: SiteMetadata.org.name,
  sameAs: social.map((s) => s.data.link),
  url: SiteMetadata.org.url
}

const breadcrumbList: WithContext<BreadcrumbList> = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  description: 'Breadcrumbs list',
  itemListElement: [
    {
      '@type': 'ListItem',
      item: {
        '@id': siteurl.toString(),
        name: SiteMetadata.title
      },
      position: 1
    },
    {
      '@type': 'ListItem',
      item: {
        '@id': Astro.url.toString(),
        name: frontmatter.title
      },
      position: 2
    }
  ],
  numberOfItems: 2,
  name: 'Breadcrumbs'
}

const person: WithContext<Person> = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': SiteMetadata.author.url,
  name: SiteMetadata.author.name,
  url: SiteMetadata.author.url,
  worksFor: {
    '@id': SiteMetadata.org.url
  }
}

// Conditional Article Schema
let article: WithContext<Article> | undefined
if (isBlog || isNews) {
  article = {
    '@context': 'https://schema.org',
    '@type': 'Article',
    articleSection: type,
    author: {
      '@type': 'Person',
      name: SiteMetadata.author.name,
      url: SiteMetadata.author.url
    },
    copyrightHolder: {
      '@id': SiteMetadata.org.url
    },
    copyrightYear: year,
    creativeWorkStatus: 'Published',
    creator: {
      '@id': SiteMetadata.author.url
    },
    dateCreated: publishDate.toISOString(),
    dateModified: SiteMetadata.buildTime.toISOString(),
    datePublished: publishDate.toISOString(),
    description: frontmatter.description,
    headline: frontmatter.title,
    image: {
      '@type': 'ImageObject',
      url: new URL(image.src, Astro.url).toString()
    },
    inLanguage: 'en-AU',
    mainEntityOfPage: SiteMetadata.org.url,
    name: frontmatter.title,
    publisher: {
      '@id': SiteMetadata.org.url
    },
    url: siteurl.toString()
  }
}

// Conditional Event Schema for Meetings
let event: WithContext<Event> | undefined
if (isMeeting) {
  event = {
    '@context': 'https://schema.org',
    '@type': 'Event',
    name: frontmatter.title ?? 'AIR Sydney Hills Meeting',
    description: frontmatter.description,
    startDate: publishDate.toISOString(),
    location: {
      '@type': 'Place',
      name: "Molly's Pavilion (The Cheltenham Recreation Club)",
      address: {
        '@type': 'PostalAddress',
        streetAddress: '60-74 The Crescent',
        addressLocality: 'Cheltenham',
        addressRegion: 'NSW',
        postalCode: '2119',
        addressCountry: 'AU'
      }
    },
    image: new URL(image.src, Astro.url).toString(),
    organizer: {
      '@id': SiteMetadata.org.url
    }
  }
}
---

<SEO
  title={SiteMetadata.title + ' | ' + frontmatter.title}
  description={frontmatter.description}
  canonical={canonicalURL}
  {openGraph}
  {twitter}
/>
<script is:inline set:html={JSON.stringify(website)} type="application/ld+json" />
<script is:inline set:html={JSON.stringify(organization)} type="application/ld+json" />
<script is:inline set:html={JSON.stringify(breadcrumbList)} type="application/ld+json" />
<script is:inline set:html={JSON.stringify(person)} type="application/ld+json" />
{article && <script is:inline set:html={JSON.stringify(article)} type="application/ld+json" />}
{event && <script is:inline set:html={JSON.stringify(event)} type="application/ld+json" />}
