---

---

<theme-dropdown class="relative ml-3 block">
  <div>
    <button
      type="button"
      class="dark:orange-700 inline-flex w-full justify-center rounded-md border border-orange-500 bg-white px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-orange-500 hover:text-gray-200 focus:ring-2 focus:ring-orange-500 focus:ring-offset-2 focus:ring-offset-orange-300 focus:outline-none dark:bg-gray-800 dark:text-gray-200 dark:focus:ring-offset-orange-700"
      id="theme-menu-button"
      aria-expanded="false"
      aria-haspopup="true"
    >
      Light/Dark
      <div class="i-heroicons-chevron-down-20-solid -mr-1 ml-2 h-5 w-5" aria-hidden="true"></div>
    </button>
  </div>
  <ul
    id="theme-menu"
    class="ring-opacity-5 absolute right-0 z-20 mt-1 hidden max-h-56 w-32 overflow-auto rounded-md bg-white py-1 text-base shadow-lg ring-1 ring-black focus:outline-none sm:text-sm dark:bg-gray-700"
    tabindex="-1"
    role="listbox"
    aria-labelledby="listbox-label"
  >
    <li
      class="relative cursor-default py-2 pr-4 pl-2 text-gray-900 select-none hover:bg-orange-600 hover:text-white dark:bg-gray-700 dark:text-white dark:hover:bg-orange-300 dark:hover:text-gray-900"
      data-theme-option="system"
      role="option"
    >
      <div class="flex items-center">
        <div class="i-heroicons-star h-6 w-6"></div>
        <span class="ml-1 block truncate">System</span>
      </div>
      <span
        data-check="system"
        class="absolute inset-y-0 right-0 hidden items-center pr-4 text-green-600 hover:text-white"
      >
        <div class="i-heroicons-check-20-solid h-5 w-5"></div>
      </span>
    </li>
    <li
      class="relative cursor-default py-2 pr-4 pl-2 text-gray-900 select-none hover:bg-orange-600 hover:text-white dark:bg-gray-700 dark:text-white dark:hover:bg-orange-300 dark:hover:text-gray-900"
      data-theme-option="light"
      role="option"
    >
      <div class="flex items-center">
        <div class="i-heroicons-sun h-6 w-6"></div>
        <span class="ml-1 block truncate">Light</span>
      </div>
      <span
        data-check="light"
        class="absolute inset-y-0 right-0 hidden items-center pr-4 text-green-600 hover:text-white"
      >
        <div class="i-heroicons-check-20-solid h-5 w-5"></div>
      </span>
    </li>
    <li
      class="relative cursor-default py-2 pr-4 pl-2 text-gray-900 select-none hover:bg-orange-600 hover:text-white dark:bg-gray-700 dark:text-white dark:hover:bg-orange-300 dark:hover:text-gray-900"
      data-theme-option="dark"
      role="option"
    >
      <div class="flex items-center">
        <div class="i-heroicons-moon-solid h-6 w-6"></div>
        <span class="ml-1 block truncate">Dark</span>
      </div>
      <span
        data-check="dark"
        class="absolute inset-y-0 right-0 hidden items-center pr-4 text-green-600 hover:text-white"
      >
        <div class="i-heroicons-check-20-solid h-5 w-5"></div>
      </span>
    </li>
  </ul>
</theme-dropdown>

<script>
  class ThemeDropdown extends HTMLElement {
    constructor() {
      super()
      const button = this.querySelector('#theme-menu-button') as HTMLButtonElement | null
      const menu = this.querySelector('#theme-menu') as HTMLElement | null
      const options = this.querySelectorAll('[data-theme-option]')

      if (button && menu) {
        const toggleMenu = () => {
          const isOpen = button.getAttribute('aria-expanded') === 'true'
          button.setAttribute('aria-expanded', String(!isOpen))
          menu.classList.toggle('hidden')
          if (!isOpen) {
            this.updateSelection()
          }
        }

        button.addEventListener('click', (e) => {
          e.stopPropagation()
          toggleMenu()
        })

        options.forEach((option) => {
          option.addEventListener('click', () => {
            const theme = option.getAttribute('data-theme-option')
            if (theme === 'system') {
              localStorage.removeItem('theme')
            } else if (theme) {
              localStorage.theme = theme
            }
            window.dispatchEvent(new CustomEvent('theme-changed'))
            toggleMenu()
          })
        })

        document.addEventListener('click', (e) => {
          if (!this.contains(e.target as Node)) {
            button.setAttribute('aria-expanded', 'false')
            menu.classList.add('hidden')
          }
        })
      }
    }

    connectedCallback() {
      this.updateSelection()
    }

    updateSelection() {
      const currentTheme = localStorage.theme || 'system'
      const options = this.querySelectorAll('[data-theme-option]')
      options.forEach((option) => {
        const theme = option.getAttribute('data-theme-option')
        const text = option.querySelector('span')
        const check = option.querySelector('[data-check]')

        if (theme === currentTheme && text && check) {
          text.classList.add('font-semibold')
          text.classList.remove('font-normal')
          check.classList.remove('hidden')
          check.classList.add('flex')
        } else if (text && check) {
          text.classList.add('font-normal')
          text.classList.remove('font-semibold')
          check.classList.add('hidden')
          check.classList.remove('flex')
        }
      })
    }
  }

  customElements.define('theme-dropdown', ThemeDropdown)
</script>
