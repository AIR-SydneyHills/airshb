---
import { Image } from 'astro:assets'
import { DefaultImage } from '../config'

export interface Props {
  title: string
  description?: string
  image?: ImageMetadata
}

const { title, description, image } = Astro.props
---

<header class="mx-auto my-4 w-full max-w-screen-lg lg:my-6">
  <h1
    class="mb-4 text-3xl text-gray-900 font-extrabold leading-tight lg:mb-6 lg:text-4xl dark:text-white"
  >
    {title}
  </h1>
  <p class="my-6 text-xl font-light italic">
    {description}
  </p>
  <figure class="mx-auto px-4 lg:max-w-screen-md">
    <Image class="rounded-lg" src={image || DefaultImage} alt={title} />
  </figure>
</header>
