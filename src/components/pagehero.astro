---
import { Image } from 'astro:assets'

import { DefaultImage } from '../config'

import type { CollectionEntry } from 'astro:content'

export interface Props {
  frontmatter: CollectionEntry<'page'>['data']
}

const { frontmatter } = Astro.props
---

<header class="mx-auto my-4 w-full max-w-screen-lg lg:my-6">
  <h1
    class="mb-4 text-3xl leading-tight font-extrabold text-gray-900 lg:mb-6 lg:text-4xl dark:text-white"
  >
    {frontmatter.title}
  </h1>
  <p class="my-6 text-xl font-light italic">
    {frontmatter.description}
  </p>
  {
    frontmatter.image && (
      <figure class="mx-auto px-4 lg:max-w-screen-md">
        <Image class="rounded-lg" src={frontmatter.image || DefaultImage} alt={frontmatter.title} />
      </figure>
    )
  }
</header>
