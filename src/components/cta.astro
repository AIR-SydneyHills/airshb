---
import Button from './button.astro'
---

<section class="bg-white dark:bg-gray-900">
  <div class="mx-auto max-w-screen-xl px-4 py-8 sm:py-16 lg:px-6">
    <div class="mx-auto max-w-screen-sm text-center">
      <h2
        class="mb-4 text-4xl leading-tight font-extrabold tracking-tight text-gray-900 dark:text-white"
      >
        Interested? Join AIR today
      </h2>
      <p class="mb-6 font-light text-gray-700 md:text-lg dark:text-gray-400">
        Membership of AIR is open to anyone over 50 who is or planning to be fully or partly
        self-funded in their retirement.
      </p>
      <Button href="https://www.independentretirees.com/membership/join-air">Join</Button>
    </div>
  </div>
</section>
