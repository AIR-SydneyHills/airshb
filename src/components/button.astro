---
interface Props {
  variant?: 'primary' | 'secondary'
  href?: string
  class?: string
  [key: string]: any
}

const { variant = 'primary', href, class: className, ...rest } = Astro.props

const baseStyles =
  'inline-flex items-center justify-center rounded-lg px-5 py-3 text-center text-base font-medium transition duration-150 ease-in-out focus:outline-none focus:ring-4'

const variants = {
  primary:
    'bg-orange-700 text-white hover:bg-orange-800 focus:ring-orange-300 dark:bg-orange-600 dark:hover:bg-orange-700 dark:focus:ring-orange-800',
  secondary:
    'bg-orange-100 text-orange-800 hover:bg-orange-200 focus:ring-orange-200 dark:bg-gray-800 dark:text-gray-100 dark:hover:bg-gray-700'
}

const Element = href ? 'a' : 'button'
---

<Element href={href} class:list={[baseStyles, variants[variant], className]} {...rest}>
  <slot />
</Element>
