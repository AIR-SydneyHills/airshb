---
import { getCollection } from 'astro:content'

import { Logo, SiteMetadata } from '../config'

const social = await getCollection('social')
---

<div class="h-24 lg:h-16"></div>
<footer class="text-gray-600 dark:text-gray-400">
  <div
    class="fixed inset-x-0 bottom-0 z-20 flex w-full flex-col items-center border-t-2 border-orange-500 bg-gray-100 px-4 py-1 lg:flex-row lg:px-8 lg:py-4 dark:border-orange-600 dark:bg-gray-800"
  >
    <span class="flex flex-none flex-row items-center">
      <a
        class="title-font dark:text:gray-100 flex items-center justify-center font-medium text-gray-900 lg:justify-start"
        href={import.meta.env.BASE_URL}
      >
        <img src={Logo.src} alt="Footer Logo" class="h-8 dark:bg-gray-100" loading="lazy" />
        <span class="sr-only">Logo</span>
      </a>
      <p
        class="ml-2 border-l-2 border-orange-500 py-1 pl-2 text-sm text-gray-700 dark:border-orange-600 dark:text-gray-300"
      >
        © {new Date().getFullYear()}
        <a
          href={Astro.site}
          class="ml-1 text-orange-700 hover:text-pink-600 dark:text-orange-400 dark:hover:text-pink-300"
          rel="noopener noreferrer"
          target="_blank"
        >
          {SiteMetadata.title}
        </a>
      </p>
    </span>
    <span class="flex flex-none flex-row items-center">
      <p
        class="text-sm text-gray-700 lg:ml-4 lg:border-l-2 lg:border-orange-500 lg:py-1 lg:pl-4 dark:text-gray-300 dark:lg:border-orange-600"
      >
        <a
          href={import.meta.env.BASE_URL + 'privacy'}
          class="ml-1 text-orange-700 hover:text-orange-800 dark:text-orange-400 dark:hover:text-orange-300"
        >
          Privacy Policy
        </a>
      </p>
    </span>
    <span class="mt-2 inline-flex grow justify-center lg:mt-0 lg:ml-auto lg:justify-end">
      {
        social.map((s) => (
          <a
            href={s.data.link}
            class="ml-3 text-orange-700 hover:text-pink-600 dark:text-orange-400 dark:hover:text-orange-300"
            rel="noopener noreferrer"
            target="_blank"
          >
            <div class={`i-bi-${s.data.icon} h-5 w-5`} />
            <span class="sr-only">{s.data.name}</span>
          </a>
        ))
      }
    </span>
  </div>
</footer>
