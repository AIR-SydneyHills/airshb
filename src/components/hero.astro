---
import { Image } from 'astro:assets'

import { FeaturedImage } from '../config'
import Button from './button.astro'
---

<div class="relative overflow-hidden bg-white dark:bg-gray-900">
  <div class="mx-auto max-w-7xl">
    <div
      class="relative z-10 bg-white pb-8 sm:pb-16 md:pb-20 lg:w-full lg:max-w-2xl lg:pb-28 xl:pb-32 dark:bg-gray-900"
    >
      <svg
        class="absolute inset-y-0 right-0 hidden h-full w-48 translate-x-1/2 transform text-white lg:block dark:text-gray-900"
        fill="currentColor"
        viewBox="0 0 100 100"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <polygon points="50,0 100,0 50,100 0,100"></polygon>
      </svg>
      <main
        class="mx-auto max-w-7xl px-4 pt-10 sm:px-6 sm:pt-12 md:pt-16 lg:px-8 lg:pt-20 xl:pt-28"
      >
        <div class="text-center sm:text-left">
          <h1
            class="text-left text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl md:text-6xl dark:text-gray-100"
          >
            <span class="block text-orange-700 xl:inline dark:text-orange-300">Astro Blog</span>
          </h1>
          <p
            class="mt-3 text-base text-gray-700 sm:mx-auto sm:mt-5 sm:max-w-xl sm:text-lg md:mt-5 md:text-xl lg:mx-0 dark:text-gray-300"
          >
            Astro Blog is a starter template written in Typescript, UnoCSS (using TailwindCSS
            directives), AlpineJS and Astro. It supports Markdown blog posts (including photo
            galleries), plus full text search.
          </p>
          <p
            class="mt-3 text-base text-gray-700 sm:mx-auto sm:mt-5 sm:max-w-xl sm:text-lg md:mt-5 md:text-xl lg:mx-0 dark:text-gray-300"
          >
            It has full SEO support for Facebook (Open Graph) tags, Twitter Cards and Schema/JSON-LD
            metadata. It also features fully auto generated RSS feed and sitemap for search engine
            indexing.
          </p>
          <div class="mt-5 sm:mt-8 sm:flex sm:justify-center lg:justify-start">
            <div class="rounded-md shadow">
              <Button href="/about">About</Button>
            </div>
            <div class="mt-3 sm:mt-0 sm:ml-3">
              <Button
                variant="secondary"
                href="https://github.com/sponsors/hellotham"
                rel="noopener noreferrer"
                target="_blank"
              >
                Sponsor Us
              </Button>
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>
  <div class="bg-orange-100 lg:absolute lg:inset-y-0 lg:right-0 lg:w-1/2 dark:bg-orange-500">
    <Image
      class="h-56 w-full object-cover sm:h-72 md:h-96 lg:h-full lg:w-full"
      src={FeaturedImage}
      alt="a beautiful field of flowers next to a lake surrounded by mountains and trees at sunset"
    />
  </div>
</div>
