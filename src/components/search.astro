---

---

<script is:inline src="https://unpkg.com/lunr/lunr.min.js"></script>
<search-modal>
  <div class="flex justify-center">
    <div class="w-48">
      <div class="input-group relative w-full flex items-stretch">
        <input
          type="search"
          class="form-control relative m-0 block max-w-xs min-w-0 w-full flex-auto border border-orange-500 rounded border-solid bg-white bg-clip-padding px-3 py-1.5 text-base text-gray-500 font-normal transition ease-in-out dark:border-orange-700 focus:border-orange-600 dark:bg-gray-900 dark:text-gray-300 focus:text-gray-700 focus:outline-none dark:focus:border-orange-600 dark:focus:text-gray-100"
          id="lunrsearch"
          name="q"
          maxlength="255"
          value=""
          placeholder="Search"
          aria-label="Search"
          aria-describedby="lunrbutton"
        />
        <button
          class="btn inline-block items-center rounded bg-orange-600 px-2 py-2 text-xs text-white font-medium leading-tight uppercase shadow-md transition duration-150 ease-in-out active:bg-orange-800 dark:bg-orange-500 focus:bg-orange-700 hover:bg-orange-300 hover:text-orange-800 active:shadow-lg focus:shadow-lg hover:shadow-lg focus:outline-none focus:ring-0 dark:hover:bg-orange-300 dark:hover:text-orange-800"
          type="button"
          name="search"
          id="lunrbutton"
          aria-label="Search Button"
        >
          <svg
            aria-hidden="true"
            focusable="false"
            data-prefix="fas"
            data-icon="search"
            class="h-4 w-4"
            role="img"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 512 512"
          >
            <path
              fill="currentColor"
              d="M505 442.7L405.3 343c-4.5-4.5-10.6-7-17-7H372c27.6-35.3 44-79.7 44-128C416 93.1 322.9 0 208 0S0 93.1 0 208s93.1 208 208 208c48.3 0 92.7-16.4 128-44v16.3c0 6.4 2.5 12.5 7 17l99.7 99.7c9.4 9.4 24.6 9.4 33.9 0l28.3-28.3c9.4-9.4 9.4-24.6.1-34zM208 336c-70.7 0-128-57.2-128-128 0-70.7 57.2-128 128-128 70.7 0 128 57.2 128 128 0 70.7-57.2 128-128 128z"
            ></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
  <div
    id="search-overlay"
    class="relative z-50 hidden"
    aria-labelledby="slide-over-title"
    role="dialog"
    aria-modal="true"
  >
    <div id="search-backdrop" class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity">
    </div>

    <div class="fixed inset-0 overflow-hidden">
      <div class="absolute inset-0 overflow-hidden">
        <div class="pointer-events-none fixed inset-y-0 right-0 max-w-full flex pl-10">
          <div
            id="search-panel"
            class="pointer-events-auto relative max-w-md w-screen translate-x-full transform transition duration-500 ease-in-out sm:duration-700"
          >
            <div class="absolute left-0 top-0 flex pr-2 pt-4 -ml-8 sm:pr-4 sm:-ml-10">
              <button
                type="button"
                id="search-close"
                class="rounded-md text-orange-300 hover:text-pink-300 focus:outline-none focus:ring-2 focus:ring-white"
              >
                <span class="sr-only">Close panel</span>
                <div class="i-heroicons-x-mark h-6 w-6"></div>
              </button>
            </div>

            <div
              class="h-full flex flex-col overflow-y-scroll bg-white py-6 shadow-xl dark:bg-gray-800"
            >
              <div class="px-4 sm:px-6">
                <h2
                  class="text-lg text-gray-900 font-medium dark:text-gray-100"
                  id="lunrsearchtitle"
                >
                  Search results
                </h2>
              </div>
              <div id="lunrsearchmodal" class="relative mt-6 flex-1 px-4 sm:px-6">
                <div
                  id="lunrsearchresults"
                  class="overflow-hidden rounded-lg shadow-lg ring-1 ring-black ring-opacity-5"
                >
                  <ul></ul>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</search-modal>

<script>
  interface SearchDoc {
    url: string
    title: string
    description: string
  }

  class SearchModal extends HTMLElement {
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    private idx: any = null
    private doc: SearchDoc[] | null = null

    constructor() {
      super()
      const input = this.querySelector('#lunrsearch') as HTMLInputElement
      const button = this.querySelector('#lunrbutton') as HTMLButtonElement
      const overlay = this.querySelector('#search-overlay') as HTMLElement
      const panel = this.querySelector('#search-panel') as HTMLElement
      const closeBtn = this.querySelector('#search-close') as HTMLButtonElement
      const backdrop = this.querySelector('#search-backdrop') as HTMLElement

      const openModal = () => {
        overlay.classList.remove('hidden')
        setTimeout(() => {
          panel.classList.remove('translate-x-full')
          panel.classList.add('translate-x-0')
        }, 10)
      }

      const closeModal = () => {
        panel.classList.remove('translate-x-0')
        panel.classList.add('translate-x-full')
        setTimeout(() => {
          overlay.classList.add('hidden')
        }, 500)
      }

      button.addEventListener('click', () => {
        this.performSearch(input.value)
        openModal()
      })

      input.addEventListener('keypress', (event) => {
        if (event.key === 'Enter') {
          event.preventDefault()
          button.click()
        }
      })

      closeBtn.addEventListener('click', closeModal)
      backdrop.addEventListener('click', closeModal)
    }

    async performSearch(term: string) {
      const resultsTitle = this.querySelector('#lunrsearchtitle') as HTMLElement
      const resultsContainer = this.querySelector('#lunrsearchresults ul') as HTMLElement

      if (!this.doc) {
        const res = await fetch(`${import.meta.env.BASE_URL}search-docs.json`)
        this.doc = (await res.json()) as SearchDoc[]
      }
      if (!this.idx) {
        const res = await fetch(`${import.meta.env.BASE_URL}search-index.json`)
        const data = await res.json()
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        this.idx = (window as any).lunr.Index.load(data)
      }

      resultsContainer.innerHTML = ''
      if (term && this.doc && this.idx) {
        resultsTitle.innerHTML = `Search results for '${term}'`
        const results = this.idx.search(term)
        if (results.length > 0) {
          results.forEach((result: { ref: string }) => {
            const url = result.ref
            const doc = this.doc?.find((d) => d.url === url)
            if (doc) {
              const li = document.createElement('li')
              li.className =
                '-m-3 p-3 flex items-start rounded-lg hover:bg-orange-200 dark:hover:bg-orange-900'
              li.innerHTML = `
                <a href="${url}">
                  <p class="text-base font-medium text-gray-900 dark:text-gray-100">${doc.title}</p>
                  <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">${doc.description}</p>
                </a>
              `
              resultsContainer.appendChild(li)
            }
          })
        } else {
          resultsContainer.innerHTML = '<li class="p-3">No results found...</li>'
        }
      }
    }
  }

  customElements.define('search-modal', SearchModal)
</script>
