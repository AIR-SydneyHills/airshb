---
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'
import { getEntry } from 'astro:content'

import Categories from '../components/categories.astro'
import Tags from '../components/tags.astro'

export interface Props {
  post: CollectionEntry<'blog'>
}

const { post } = Astro.props

let author = await getEntry('author', 'air-sydney-hills')
if (post.data.author) {
  author = await getEntry(post.data.author)
}
---

<header class="mx-auto my-4 w-full max-w-screen-lg lg:my-6">
  {post.data.categories && <Categories categories={post.data.categories} />}
  <h1
    class="mb-4 text-3xl text-gray-900 font-extrabold leading-tight lg:mb-6 lg:text-4xl dark:text-white"
  >
    {post.data.title}
  </h1>
  <address class="mb-6 flex items-center not-italic">
    <div class="mr-3 inline-flex items-center text-base text-gray-500 dark:text-gray-400">
      {
        post.data.author && (
          <span class="mr-6 flex items-center">
            <Image
              src={author!.data.image as ImageMetadata}
              alt={author!.data.title}
              class="mr-2 h-10 w-10 rounded-full object-cover"
            />
            {author!.data.title}
          </span>
        )
      }
      {
        post.data.pubDate && (
          <span class="mr-6 flex items-center">
            <div class="i-heroicons-calendar-days mr-1 h-6 w-6" />
            {new Date(post.data.pubDate).toLocaleString('en-AU', { timeZone: 'Australia/Sydney' })}
          </span>
        )
      }
    </div>
  </address>
  <Tags tags={post.data.tags} />
  <p class="my-6 text-xl font-light italic">
    {post.data.description}
  </p>
  {
    post.data.image && (
      <figure class="mx-auto px-4 lg:max-w-screen-md">
        <Image class="rounded-lg" src={post.data.image} alt={post.data.title!} />
      </figure>
    )
  }
</header>
