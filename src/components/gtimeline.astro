---
import type { CollectionEntry } from 'astro:content'
export interface Props {
  meetings: CollectionEntry<'meeting'>[]
}

const { meetings } = Astro.props
const now = new Date()
let latest = true
---

<section class="bg-white dark:bg-gray-900">
  <div class="mx-auto max-w-screen-xl px-4 py-8 lg:px-6 lg:py-16">
    <div class="mx-auto mb-8 lg:mb-16">
      <h2 class="mb-4 text-2xl font-extrabold text-orange-800 md:text-4xl dark:text-orange-200">
        Past Meetings
      </h2>
      <p class="mb-4 font-light text-gray-500 sm:text-xl dark:text-gray-400">
        The following is a summary of previous meetings and their topics.
      </p>
    </div>
    <ol class="relative border-s border-gray-200 px-4 lg:px-6 dark:border-gray-700">
      {
        meetings.map((meeting) => (
          <li class="ms-8 mb-10">
            <span class="absolute -start-4 flex h-8 w-8 items-center justify-center rounded-full bg-orange-500 ring-8 ring-white dark:ring-gray-800">
              <svg
                class="h-5 w-5 text-orange-800"
                aria-hidden="true"
                xmlns="http://www.w3.org/2000/svg"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path d="M20 4a2 2 0 0 0-2-2h-2V1a1 1 0 0 0-2 0v1h-3V1a1 1 0 0 0-2 0v1H6V1a1 1 0 0 0-2 0v1H2a2 2 0 0 0-2 2v2h20V4ZM0 18a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8H0v10Zm5-8h10a1 1 0 0 1 0 2H5a1 1 0 0 1 0-2Z" />
              </svg>
            </span>
            <h3 class="mb-1 flex items-center text-lg font-semibold text-gray-900 dark:text-white">
              {meeting.data.title}
              {latest &&
                meeting.data.pubDate &&
                meeting.data.pubDate < now &&
                !(latest = false) && (
                  <span class="ms-3 me-2 rounded bg-orange-600 px-2.5 py-0.5 text-sm font-medium text-gray-200 dark:bg-orange-600 dark:text-gray-200">
                    Latest
                  </span>
                )}
            </h3>
            <time class="mb-2 block text-sm leading-none font-normal text-gray-400 dark:text-gray-500">
              {meeting.data.pubDate?.toLocaleString('en-AU', { timeZone: 'Australia/Sydney' })}
            </time>
            <p class="mb-4 text-base font-normal text-gray-500 dark:text-gray-400">
              {meeting.data.description}
            </p>
            <a
              href={`${import.meta.env.BASE_URL}meeting/${meeting.id}`}
              class="inline-flex rounded-md bg-orange-100 p-2 text-sm text-orange-700 hover:bg-orange-200 dark:bg-orange-900 dark:text-orange-300 dark:hover:bg-orange-800"
            >
              <svg
                class="mr-2 h-4 w-4"
                aria-hidden="true"
                xmlns="http://www.w3.org/2000/svg"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path d="M14.707 7.793a1 1 0 0 0-1.414 0L11 10.086V1.5a1 1 0 0 0-2 0v8.586L6.707 7.793a1 1 0 1 0-1.414 1.414l4 4a1 1 0 0 0 1.416 0l4-4a1 1 0 0 0-.002-1.414Z" />
                <path d="M18 12h-2.55l-2.975 2.975a3.5 3.5 0 0 1-4.95 0L4.55 12H2a2 2 0 0 0-2 2v4a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-4a2 2 0 0 0-2-2Zm-3 5a1 1 0 1 1 0-2 1 1 0 0 1 0 2Z" />
              </svg>
              Read More
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>
