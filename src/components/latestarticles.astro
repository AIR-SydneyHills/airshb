---
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'

// import Categories from '../components/categories.astro'
import { DefaultImage } from '../config'
import Button from './button.astro'

export interface Props {
  posts: CollectionEntry<'blog'>[]
}

const { posts } = Astro.props

const newestPost = posts[0]
const otherPosts = posts.slice(1, 5)
---

<div class="bg-white dark:bg-gray-900">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl py-8 sm:py-12 lg:max-w-none lg:py-16">
      <h2 class="text-2xl font-extrabold text-orange-800 md:text-4xl dark:text-orange-200">
        Articles
      </h2>
      <div class="flex">
        <Button href={import.meta.env.BASE_URL + 'blog'} class="mt-2 ml-4"> All Articles </Button>
        <Button
          variant="secondary"
          href={import.meta.env.BASE_URL + 'categories'}
          class="mt-2 ml-4"
        >
          Categories
        </Button>
        <Button variant="secondary" href={import.meta.env.BASE_URL + 'tags'} class="mt-2 ml-4">
          Tags
        </Button>
      </div>
      <div class="mt-6 space-y-12 lg:grid lg:grid-cols-2 lg:space-y-0 lg:gap-x-6">
        <div class="relative mb-4 block rounded p-4 lg:mb-0 lg:p-0">
          <a href={import.meta.env.BASE_URL + 'blog/' + newestPost.id}>
            <span class="sr-only">{newestPost.data.title}</span>
            <Image
              src={newestPost.data.image ?? DefaultImage}
              alt={newestPost.data.title + ' featured image'}
              class="w-full rounded-md bg-orange-100 object-cover dark:bg-orange-800"
              loading="lazy"
            />
          </a>
          <!-- <div class='mt-4'>
            {newestPost.data.categories && <Categories categories={newestPost.data.categories} />}
          </div> -->
          <a href={import.meta.env.BASE_URL + 'blog/' + newestPost.id}>
            <h1
              class="mt-2 text-3xl leading-tight font-bold text-orange-700 hover:text-orange-600 dark:text-orange-300 dark:hover:text-orange-400"
            >
              {newestPost.data.title}
            </h1>
          </a>
          {
            newestPost.data.pubDate && (
              <p class="mb-4 text-gray-700 dark:text-gray-400">
                {newestPost.data.pubDate.toLocaleDateString('en-AU', {
                  timeZone: 'Australia/Sydney'
                })}
              </p>
            )
          }
          <p class="mb-4 text-gray-700 dark:text-gray-400">
            {newestPost.data.description}
          </p>
          <Button
            variant="secondary"
            href={import.meta.env.BASE_URL + 'blog/' + newestPost.id}
            class="!px-2 !py-2 !text-sm"
          >
            <div class="i-heroicons-arrow-down-tray mr-2 h-4 w-4"></div>
            Read more
            <span class="sr-only">{newestPost.data.title}</span>
          </Button>
        </div>
        <div class="w-full">
          {
            otherPosts.map((post) => (
              <div class="mb-10 w-full md:grid md:grid-cols-3">
                <a href={new URL(import.meta.env.BASE_URL + 'blog/' + post.id, Astro.url)}>
                  <Image
                    src={post.data.image ?? DefaultImage}
                    alt={post.data.title + ' featured image'}
                    class="block w-full rounded-md bg-orange-100 object-cover p-4 md:p-0 lg:block dark:bg-orange-800"
                    loading="lazy"
                  />
                </a>
                <div class="bg-white px-4 md:col-span-2 dark:bg-gray-900">
                  <a href={import.meta.env.BASE_URL + 'blog/' + post.id}>
                    <div class="text-xl font-semibold text-gray-800 md:mt-1 dark:text-gray-100">
                      {post.data.title}
                    </div>
                  </a>
                  {post.data.pubDate && (
                    <p class="block text-sm text-gray-700 dark:text-gray-300">
                      {post.data.pubDate.toLocaleDateString('en-AU', {
                        timeZone: 'Australia/Sydney'
                      })}
                    </p>
                  )}
                  <p class="block text-sm text-gray-700 md:hidden dark:text-gray-300">
                    {post.data.description}
                  </p>
                  <Button
                    variant="secondary"
                    href={import.meta.env.BASE_URL + 'blog/' + post.id}
                    class="mt-2 !px-2 !py-2 !text-sm"
                  >
                    <div class="i-heroicons-arrow-down-tray mr-2 h-4 w-4" />
                    Read more
                    <span class="sr-only">{newestPost.data.title}</span>
                  </Button>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</div>
