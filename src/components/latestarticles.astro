---
import type { CollectionEntry } from 'astro:content'
import { Image } from 'astro:assets'
// import Categories from '../components/categories.astro'
import { DefaultImage } from '../config'

export interface Props {
  posts: CollectionEntry<'blog'>[]
}

const { posts } = Astro.props

const newestPost = posts[0]
const otherPosts = posts.slice(1, 5)
---

<div class="bg-white dark:bg-gray-900">
  <div class="mx-auto max-w-7xl px-4 lg:px-8 sm:px-6">
    <div class="mx-auto max-w-2xl py-8 lg:max-w-none lg:py-16 sm:py-12">
      <div class="flex flex-row items-center">
        <h2 class="text-2xl text-orange-800 font-extrabold md:text-4xl dark:text-orange-200">
          Our Latest Articles
        </h2>
        <a
          href={import.meta.env.BASE_URL + 'blog'}
          class="ml-4 mt-2 inline-block rounded-md bg-orange-600 px-2 py-2 text-base text-white font-bold dark:bg-orange-300 hover:bg-orange-500 md:px-6 md:py-3 md:text-lg dark:text-black dark:hover:bg-orange-400"
        >
          All Articles
        </a>
        <a
          href={import.meta.env.BASE_URL + 'categories'}
          class="ml-4 mt-2 inline-block rounded-md bg-orange-100 px-2 py-2 text-base text-orange-800 font-bold dark:bg-orange-900 hover:bg-orange-200 md:px-6 md:py-3 md:text-lg dark:text-orange-100 dark:hover:bg-orange-800"
        >
          Categories
        </a>
        <a
          href={import.meta.env.BASE_URL + 'tags'}
          class="ml-4 mt-2 inline-block rounded-md bg-orange-100 px-2 py-2 text-base text-orange-800 font-bold dark:bg-orange-900 hover:bg-orange-200 md:px-6 md:py-3 md:text-lg dark:text-orange-100 dark:hover:bg-orange-800"
        >
          Tags
        </a>
      </div>
      <div class="mt-6 lg:grid lg:grid-cols-2 lg:gap-x-6 space-y-12 lg:space-y-0">
        <div class="relative mb-4 block rounded p-4 lg:mb-0 lg:p-0">
          <a href={import.meta.env.BASE_URL + 'blog/' + newestPost.id}>
            <span class="sr-only">{newestPost.data.title}</span>
            <Image
              src={newestPost.data.image || DefaultImage}
              alt={newestPost.data.title + ' featured image'}
              class="w-full rounded-md bg-orange-100 object-cover dark:bg-orange-800"
              loading="lazy"
            />
          </a>
          <!-- <div class='mt-4'>
            {newestPost.data.categories && <Categories categories={newestPost.data.categories} />}
          </div> -->
          <a href={import.meta.env.BASE_URL + 'blog/' + newestPost.id}>
            <h1
              class="mt-2 text-3xl text-orange-700 font-bold leading-tight dark:text-orange-300 hover:text-orange-600 dark:hover:text-orange-400"
            >
              {newestPost.data.title}
            </h1>
          </a>
          {
            newestPost.data.pubDate && (
              <p class="mb-4 text-gray-600 dark:text-gray-400">
                {newestPost.data.pubDate.toLocaleDateString('en-AU', {
                  timeZone: 'Australia/Sydney'
                })}
              </p>
            )
          }
          <p class="mb-4 text-gray-600 dark:text-gray-400">
            {newestPost.data.description}
          </p>
          <a
            href={import.meta.env.BASE_URL + 'blog/' + newestPost.id}
            class="inline-flex rounded-md bg-orange-100 p-2 text-sm text-orange-700 dark:bg-orange-900 hover:bg-orange-200 dark:text-orange-300 dark:hover:bg-orange-800"
          >
            <svg
              class="mr-2 h-4 w-4"
              aria-hidden="true"
              xmlns="http://www.w3.org/2000/svg"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                d="M14.707 7.793a1 1 0 0 0-1.414 0L11 10.086V1.5a1 1 0 0 0-2 0v8.586L6.707 7.793a1 1 0 1 0-1.414 1.414l4 4a1 1 0 0 0 1.416 0l4-4a1 1 0 0 0-.002-1.414Z"
              ></path>
              <path
                d="M18 12h-2.55l-2.975 2.975a3.5 3.5 0 0 1-4.95 0L4.55 12H2a2 2 0 0 0-2 2v4a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-4a2 2 0 0 0-2-2Zm-3 5a1 1 0 1 1 0-2 1 1 0 0 1 0 2Z"
              ></path>
            </svg>
            Read more
            <span class="sr-only">{newestPost.data.title}</span>
          </a>
        </div>
        <div class="w-full">
          {
            otherPosts.map((post) => (
              <div class="mb-10 w-full md:grid md:grid-cols-3">
                <a href={new URL(import.meta.env.BASE_URL + 'blog/' + post.id, Astro.url)}>
                  <Image
                    src={post.data.image || DefaultImage}
                    alt={post.data.title + ' featured image'}
                    class="block w-full rounded-md bg-orange-100 object-cover p-4 lg:block dark:bg-orange-800 md:p-0"
                    loading="lazy"
                  />
                </a>
                <div class="bg-white px-4 md:col-span-2 dark:bg-gray-900">
                  <a href={import.meta.env.BASE_URL + 'blog/' + post.id}>
                    <div class="text-xl text-gray-800 font-semibold md:mt-1 dark:text-gray-100">
                      {post.data.title}
                    </div>
                  </a>
                  {post.data.pubDate && (
                    <p class="block text-sm text-gray-600 dark:text-gray-300">
                      {post.data.pubDate.toLocaleDateString('en-AU', {
                        timeZone: 'Australia/Sydney'
                      })}
                    </p>
                  )}
                  <p class="block text-sm text-gray-600 md:hidden dark:text-gray-300">
                    {post.data.description}
                  </p>
                  <a
                    href={import.meta.env.BASE_URL + 'blog/' + post.id}
                    class="mt-2 inline-flex rounded-md bg-orange-100 p-2 text-sm text-orange-700 dark:bg-orange-900 hover:bg-orange-200 dark:text-orange-300 dark:hover:bg-orange-800"
                  >
                    <svg
                      class="mr-2 h-4 w-4"
                      aria-hidden="true"
                      xmlns="http://www.w3.org/2000/svg"
                      fill="currentColor"
                      viewBox="0 0 20 20"
                    >
                      <path d="M14.707 7.793a1 1 0 0 0-1.414 0L11 10.086V1.5a1 1 0 0 0-2 0v8.586L6.707 7.793a1 1 0 1 0-1.414 1.414l4 4a1 1 0 0 0 1.416 0l4-4a1 1 0 0 0-.002-1.414Z" />
                      <path d="M18 12h-2.55l-2.975 2.975a3.5 3.5 0 0 1-4.95 0L4.55 12H2a2 2 0 0 0-2 2v4a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-4a2 2 0 0 0-2-2Zm-3 5a1 1 0 1 1 0-2 1 1 0 0 1 0 2Z" />
                    </svg>
                    Read more
                    <span class="sr-only">{newestPost.data.title}</span>
                  </a>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</div>
