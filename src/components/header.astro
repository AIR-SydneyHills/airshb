---
import Search from '../components/search.astro'
import Theme from '../components/theme.astro'
import { NavigationLinks } from '../config'
import { Logo } from '../config'
---

<site-nav class="relative block h-16 w-full">
  <nav class="dark:bg-gray-800">
    <div
      class="fixed z-50 mx-auto w-full border-b-2 border-orange-500 bg-white px-2 sm:px-6 lg:px-8 dark:border-orange-500 dark:bg-gray-800"
    >
      <div class="relative flex h-16 items-center justify-between">
        <div class="flex items-center">
          <div class="flex items-center xl:hidden">
            <!-- Mobile menu button-->
            <button
              type="button"
              data-menu-button
              class="inline-flex items-center justify-center rounded-md p-2 text-orange-600 hover:bg-orange-200 hover:text-gray-800 focus:ring-2 focus:ring-orange-300 focus:outline-none focus:ring-inset dark:text-orange-600 dark:hover:bg-orange-600 dark:hover:text-gray-200 dark:focus:ring-orange-500"
              aria-controls="mobile-menu"
              aria-expanded="false"
            >
              <span class="sr-only">Open main menu</span>
              <div data-menu-icon-bars class="i-heroicons-bars-3 block h-6 w-6" aria-hidden="true">
              </div>
              <div
                data-menu-icon-close
                class="i-heroicons-x-mark hidden h-6 w-6"
                aria-hidden="true"
              >
              </div>
            </button>
          </div>
          <div class="mr-3 flex flex-shrink-0 items-center">
            <img class="block h-8 sm:h-12 dark:bg-gray-100" src={Logo.src} alt="Logo" />
          </div>
          <Search />
        </div>

        <div class="flex items-center">
          <div class="hidden xl:mr-4 xl:block">
            <div class="flex space-x-2">
              {
                NavigationLinks.map((item) => (
                  <a
                    href={import.meta.env.BASE_URL + item.href}
                    class:list={[
                      'rounded-md px-2 py-2 text-lg font-medium',
                      item.href.length > 0 && Astro.url.toString().includes(item.href)
                        ? 'bg-orange-200 text-gray-800 dark:bg-orange-600 dark:text-gray-200'
                        : 'text-orange-600 hover:bg-orange-200 hover:text-orange-800 dark:text-orange-500 dark:hover:bg-orange-600 dark:hover:text-gray-200'
                    ]}
                    aria-current={
                      item.href.length > 0 && Astro.url.toString().includes(item.href)
                        ? 'page'
                        : undefined
                    }
                  >
                    {item.name}
                  </a>
                ))
              }
            </div>
          </div>
          <Theme />
        </div>
      </div>
    </div>

    <!-- Mobile menu, show/hide based on menu state. -->
    <div
      id="mobile-menu"
      class="absolute inset-x-0 top-16 z-50 hidden transform transition duration-100 ease-out"
    >
      <div
        class="flex justify-center border-t-2 border-b-2 border-orange-300 bg-gray-100 px-4 py-2 font-semibold dark:border-orange-600 dark:bg-gray-800"
      >
        {
          NavigationLinks.map((item) => (
            <a
              href={import.meta.env.BASE_URL + item.href}
              class:list={[
                item.href.length > 0 && Astro.url.toString().includes(item.href)
                  ? 'bg-orange-200 text-orange-800 dark:bg-orange-800 dark:text-orange-300'
                  : 'dark:hover:text-grey-300 text-orange-600 hover:bg-orange-200 hover:text-orange-800 dark:text-orange-300 dark:hover:bg-orange-800',
                'px-2'
              ]}
              aria-current={
                item.href.length > 0 && Astro.url.toString().includes(item.href)
                  ? 'page'
                  : undefined
              }
            >
              {item.name}
            </a>
          ))
        }
      </div>
    </div>
  </nav>
</site-nav>

<script>
  class SiteNav extends HTMLElement {
    constructor() {
      super()
      const button = this.querySelector('[data-menu-button]')
      const menu = this.querySelector('#mobile-menu')
      const iconBars = this.querySelector('[data-menu-icon-bars]')
      const iconClose = this.querySelector('[data-menu-icon-close]')

      if (button && menu && iconBars && iconClose) {
        button.addEventListener('click', () => {
          const isExpanded = button.getAttribute('aria-expanded') === 'true' || false
          button.setAttribute('aria-expanded', String(!isExpanded))
          menu.classList.toggle('hidden')
          iconBars.classList.toggle('hidden')
          iconClose.classList.toggle('hidden')
        })
      }
    }
  }

  customElements.define('site-nav', SiteNav)
</script>
