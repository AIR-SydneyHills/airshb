---
import Button from './button.astro'

import type { Page } from 'astro'
import type { CollectionEntry } from 'astro:content'

export interface Props {
  base: string
  page: Page<CollectionEntry<'blog'>>
}

// const { id } = Astro.params
const { base, page } = Astro.props
---

<div class="mt-4 flex items-center">
  <Button variant="secondary" href={import.meta.env.BASE_URL + 'categories'} class="!px-2 !py-1">
    Categories
  </Button>
  <Button variant="secondary" href={import.meta.env.BASE_URL + 'tags'} class="ml-4 !px-2 !py-1">
    Tags
  </Button>
  <Button variant="secondary" href={import.meta.env.BASE_URL + 'authors'} class="ml-4 !px-2 !py-1">
    Authors
  </Button>
  {
    page.size < page.total && (
      <div class="ml-4">
        <nav
          class="relative z-0 inline-flex -space-x-px rounded-md shadow-sm"
          aria-label="Pagination"
        >
          <a
            href={page.url.prev ? import.meta.env.BASE_URL + page.url.prev.slice(1) : '#'}
            class:list={[
              'relative inline-flex items-center rounded-l-md border px-2 py-2 text-sm font-medium',
              page.url.prev
                ? 'border-orange-300 bg-white text-gray-700 hover:bg-orange-100 dark:border-orange-700 dark:bg-gray-900 dark:text-gray-300 dark:hover:bg-orange-900'
                : 'border-gray-300 bg-gray-300 text-gray-500 dark:border-gray-700 dark:bg-gray-700 dark:text-gray-500'
            ]}
          >
            <span class="sr-only">Previous</span>
            <div class="i-heroicons-chevron-left-20-solid h-5 w-5" />
          </a>
          {Array.from({ length: page.lastPage }, (_, index) => index + 1).map((i) => (
            <a
              href={base + '/' + (i > 1 ? i : '')}
              aria-current="page"
              class:list={[
                i == page.currentPage
                  ? 'z-10 border-orange-500 bg-orange-100 font-bold text-orange-800 dark:border-orange-500 dark:bg-orange-900 dark:text-orange-200'
                  : 'border-orange-300 bg-white text-gray-700 hover:bg-orange-100 dark:border-orange-700 dark:bg-gray-900 dark:text-gray-300 dark:hover:bg-orange-900',
                'relative inline-flex items-center border px-4 py-2 text-sm font-medium'
              ]}
            >
              {i}
            </a>
          ))}
          <a
            href={page.url.next ? import.meta.env.BASE_URL + page.url.next.slice(1) : '#'}
            class:list={[
              'relative inline-flex items-center rounded-r-md border px-2 py-2 text-sm font-medium',
              page.url.next
                ? 'border-orange-300 bg-white text-gray-700 hover:bg-orange-100 dark:border-orange-700 dark:bg-gray-900 dark:text-gray-300 dark:hover:bg-orange-900'
                : 'border-gray-300 bg-gray-300 text-gray-500 dark:border-gray-700 dark:bg-gray-700 dark:text-gray-500'
            ]}
          >
            <span class="sr-only">Next</span>
            <div class="i-heroicons-chevron-right-20-solid h-5 w-5" />
          </a>
        </nav>
      </div>
    )
  }
  <p class="ml-4 font-medium text-gray-700 italic dark:text-gray-300">
    Articles {page.start + 1}-{page.end + 1} (total {page.total})
  </p>
</div>
